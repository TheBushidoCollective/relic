{
  "name": "relic-mcp",
  "version": "0.3.0",
  "description": "Publish a file as an encrypted relic. The key is generated on your machine and never sent to the service.",
  "license": "MIT",
  "type": "module",
  "main": "dist/relic-mcp.js",
  "bin": {
    "relic-mcp": "dist/relic-mcp.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "encryption",
    "zero-knowledge",
    "file-sharing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBushidoCollective/relic.git",
    "directory": "packages/relic-mcp"
  },
  "homepage": "https://github.com/TheBushidoCollective/relic#readme",
  "bugs": {
    "url": "https://github.com/TheBushidoCollective/relic/issues"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".claude-plugin",
    "skills",
    "mcp-servers.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run build.ts"
  },
  "devDependencies": {
    "@relic/format": "workspace:*",
    "@relic/server": "workspace:*",
    "@relic/viewer": "workspace:*"
  }
}
